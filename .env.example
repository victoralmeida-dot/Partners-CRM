# Copie este arquivo para ".env" (que já está no .gitignore) e ajuste se precisar.
# Banco local — o arquivo fica dentro da pasta prisma/, na sua máquina.
DATABASE_URL="file:./dev.db"

# Login (Auth.js) — gere uma chave própria com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-uma-chave-aleatoria-sua"
NEXTAUTH_URL="http://localhost:3000"

# Espaço reservado para quando integrarmos o ClickUp (Fase 3).
# NUNCA preencha isso e comite o arquivo — isso fica só no seu .env local.
# CLICKUP_API_TOKEN=
# CLICKUP_LIST_ID=
